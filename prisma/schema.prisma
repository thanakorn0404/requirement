generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @db.Char(24)
  name         String
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  pinLookup    String    @map("pin_lookup")
  role         String
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([role, status])
  @@map("users")
}

model Organization {
  id          String    @id @db.Char(24)
  name        String
  type        String
  province    String
  district    String    @default("")
  subdistrict String    @default("")
  address     String    @default("") @db.Text
  phone       String    @default("")
  email       String    @default("")
  description String    @default("") @db.Text
  logoUrl     String    @default("") @map("logo_url")
  status      String    @default("active")
  createdBy   String?   @map("created_by") @db.Char(24)
  updatedBy   String?   @map("updated_by") @db.Char(24)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@index([type])
  @@index([province])
  @@index([status])
  @@map("organizations")
}

model Department {
  id             String    @id @db.Char(24)
  organizationId String    @map("organization_id") @db.Char(24)
  name           String
  code           String    @default("")
  type           String    @default("กอง")
  description    String    @default("") @db.Text
  status         String    @default("active")
  createdBy      String?   @map("created_by") @db.Char(24)
  updatedBy      String?   @map("updated_by") @db.Char(24)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@map("departments")
}

model Position {
  id           String    @id @db.Char(24)
  departmentId String    @map("department_id") @db.Char(24)
  name         String
  code         String    @default("")
  level        Int       @default(0)
  description  String    @default("") @db.Text
  status       String    @default("active")
  createdBy    String?   @map("created_by") @db.Char(24)
  updatedBy    String?   @map("updated_by") @db.Char(24)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([departmentId, name])
  @@map("positions")
}

model Person {
  id             String    @id @db.Char(24)
  organizationId String    @map("organization_id") @db.Char(24)
  departmentId   String    @map("department_id") @db.Char(24)
  positionId     String?   @map("position_id") @db.Char(24)
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  displayName    String    @map("display_name")
  phone          String    @default("")
  email          String    @default("")
  description    String    @default("") @db.Text
  status         String    @default("active")
  createdBy      String?   @map("created_by") @db.Char(24)
  updatedBy      String?   @map("updated_by") @db.Char(24)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([departmentId, displayName])
  @@index([positionId])
  @@index([organizationId, status])
  @@map("people")
}

model Workflow {
  id             String    @id @db.Char(24)
  organizationId String    @map("organization_id") @db.Char(24)
  departmentId   String    @map("department_id") @db.Char(24)
  name           String
  description    String    @default("") @db.Text
  status         String    @default("draft")
  currentVersion Int       @default(0) @map("current_version")
  shareToken     String?   @unique @map("share_token") @db.VarChar(64)
  createdBy      String?   @map("created_by") @db.Char(24)
  updatedBy      String?   @map("updated_by") @db.Char(24)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, departmentId, status])
  @@map("workflows")
}

model WorkflowBlock {
  id          String    @id @db.Char(24)
  workflowId  String    @map("workflow_id") @db.Char(24)
  title       String
  description String    @default("") @db.Text
  blockType   String    @default("work") @map("block_type")
  x           Float     @default(120)
  y           Float     @default(80)
  width       Float     @default(300)
  height      Float     @default(200)
  status      String    @default("active")
  createdBy   String?   @map("created_by") @db.Char(24)
  updatedBy   String?   @map("updated_by") @db.Char(24)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workflowId])
  @@map("workflow_blocks")
}

model WorkflowBlockResponsible {
  id             String   @id @db.Char(24)
  blockId        String   @map("block_id") @db.Char(24)
  personId       String   @map("person_id") @db.Char(24)
  responsibility String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([blockId, personId])
  @@index([personId])
  @@map("workflow_block_responsibles")
}

model WorkflowEdge {
  id            String   @id @db.Char(24)
  workflowId    String   @map("workflow_id") @db.Char(24)
  sourceBlockId String   @map("source_block_id") @db.Char(24)
  targetBlockId String   @map("target_block_id") @db.Char(24)
  sourceHandle  String   @default("bottom") @map("source_handle")
  targetHandle  String   @default("top") @map("target_handle")
  type          String   @default("smoothstep")
  label         String   @default("")
  animated      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([workflowId])
  @@index([sourceBlockId, targetBlockId])
  @@map("workflow_edges")
}

model WorkflowVersion {
  id         String   @id @db.Char(24)
  workflowId String   @map("workflow_id") @db.Char(24)
  version    Int
  name       String   @default("")
  blocks     Json
  edges      Json
  createdBy  String?  @map("created_by") @db.Char(24)
  note       String   @default("") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model Requirement {
  id                  String    @id @db.Char(24)
  organizationId      String    @map("organization_id") @db.Char(24)
  departmentId        String    @map("department_id") @db.Char(24)
  workflowId          String?   @map("workflow_id") @db.Char(24)
  blockId             String?   @map("block_id") @db.Char(24)
  responsiblePersonId String?   @map("responsible_person_id") @db.Char(24)
  positionId          String?   @map("position_id") @db.Char(24)
  requirementCode     String    @map("requirement_code")
  title               String
  category            String    @default("workflow")
  description         String    @default("") @db.Text
  input               String    @default("") @db.Text
  process             String    @default("") @db.Text
  output              String    @default("") @db.Text
  relatedDocuments    String    @default("") @db.Text @map("related_documents")
  currentProblem      String    @default("") @db.Text @map("current_problem")
  desiredBehavior     String    @default("") @db.Text @map("desired_behavior")
  priority            String    @default("medium")
  status              String    @default("draft")
  note                String    @default("") @db.Text
  orphaned            Boolean   @default(false)
  createdBy           String?   @map("created_by") @db.Char(24)
  updatedBy           String?   @map("updated_by") @db.Char(24)
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, departmentId])
  @@index([workflowId, blockId])
  @@index([requirementCode])
  @@map("requirements")
}

model AuditLog {
  id             String   @id @db.Char(24)
  actorId        String   @map("actor_id") @db.Char(24)
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @default("") @map("entity_id")
  organizationId String?  @map("organization_id") @db.Char(24)
  departmentId   String?  @map("department_id") @db.Char(24)
  oldData        Json?    @map("old_data")
  newData        Json?    @map("new_data")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([organizationId, departmentId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
